  "creative_brief": {
    "topic": "Recognise and safely report suspicious messages",
    "niche": "cybersecurity",
    "audience": "General users and students",
    "platform": "youtube_longform",
    "target_duration_seconds": 12,
    "tone": "Clear and calm",
    "visual_direction": "Technical inbox UI, sender inspection, trusted-route flow and report/delete checklist.",
    "constraints": [
      "Defensive awareness only; no live links or credentials.",
      "Fictional message uses a reserved .example domain.",
      "Follow current organisational reporting processes."
    ],
    "research_questions": [
      "What signs can indicate a suspicious message?",
      "How should a recipient verify a request safely?",
      "How should suspicious messages be reported?"
    ],
    "narration_script": "A message can look familiar and still be suspicious. Pause before opening unexpected links or files. Check the sender address, unusual urgency and mismatched details. Verify the request through a known official website or contact route, not information inside the message. Then report it using your organisation's process and delete it."
  },
