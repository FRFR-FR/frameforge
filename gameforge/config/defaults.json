{
  "generation_mode": "full_autopilot",
  "quality_strategy": "adaptive",
  "runtime": {
    "engine": "godot",
    "version": "4.4.1",
    "renderer_android_default": "gl_compatibility",
    "renderer_pc_default": "gl_compatibility"
  },
  "campaign": {
    "minimum_hours": 5,
    "maximum_hours": 10,
    "side_content": "story_relevant_only",
    "require_vertical_slice": true
  },
  "quality_gates": {
    "require_static_validation": true,
    "require_unit_tests": true,
    "require_scene_import": true,
    "require_android_export": false,
    "require_windows_export": false,
    "require_device_profile_report": true
  },
  "performance": {
    "android_low_target_fps": 30,
    "android_balanced_target_fps": 45,
    "pc_low_target_fps": 30,
    "pc_high_target_fps": 60,
    "adaptive_resolution": true,
    "low_end_profile": "low",
    "mobile_high_tier_disabled_by_default": true,
    "runtime_quality_governor": "gameforge_profile.gd"
  },
  "cutscenes": {
    "enabled": true,
    "subsystem": "gameforge/cutscenes",
    "default_resolution": "1280x720",
    "allowed_resolutions": [
      "1280x720",
      "1920x1080"
    ],
    "max_width": 1920,
    "max_height": 1080,
    "max_fps": 30,
    "max_duration_seconds": 600,
    "renderer": "Blender Cycles CPU",
    "tts_provider": "Kyutai Pocket TTS",
    "voice_ids": [
      "eponine",
      "george",
      "azelma",
      "bill_boerst",
      "jean",
      "michael",
      "peter_yearsley",
      "stuart_bell",
      "charles"
    ],
    "subtitle_background": "transparent",
    "subtitle_mode": "white text with dark outline, no box",
    "alignment_engine": "WhisperX forced character alignment",
    "output_formats": [
      "mp4",
      "srt",
      "ass",
      "blend"
    ],
    "cpu_profiles": {
      "low": {
        "samples": 8,
        "max_threads": 2,
        "texture_max_dimension": 2048
      },
      "balanced": {
        "samples": 16,
        "max_threads": 4,
        "texture_max_dimension": 4096
      },
      "high": {
        "samples": 32,
        "max_threads": 8,
        "texture_max_dimension": 4096
      }
    }
  },
  "market_research": {
    "enabled": true,
    "require_source_dates": true,
    "require_confidence_scores": true,
    "never_claim_sales_or_virality_guarantees": true
  },
  "frameforge": {
    "enabled": true,
    "integration_mode": "GAMEFORGE-only cutscene derivative; root FrameForge remains independent"
  }
}
