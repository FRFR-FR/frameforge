; GAMEFORGE BLACKTIDE — offline tactical combat game.
; No online services, networking, telemetry or account dependency.
config_version=5

[application]
config/name="BLACKTIDE: Tactical PvP"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/version="0.3.0"
run/max_fps=60

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=0

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.025, 0.04, 0.055, 1)
anti_aliasing/quality/msaa_3d=2

[physics]
3d/default_gravity=9.8
3d/physics_engine="GodotPhysics3D"

[input]
move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68)]
}
sprint={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}
crouch={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":67)]
}
jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
reload_weapon={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":82)]
}
next_weapon={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
previous_weapon={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":81)]
}
flash_grenade={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":70)]
}
cyber_shield={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":88)]
}
roll={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":86)]
}
pause_game={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}
