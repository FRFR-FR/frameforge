{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GAMEFORGE to FrameForge Cinematic Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "cinematic_id", "duration_seconds", "shots", "cues"],
  "properties": {
    "manifest_version": { "type": "string", "const": "1.0" },
    "cinematic_id": { "type": "string", "minLength": 1 },
    "duration_seconds": { "type": "number", "exclusiveMinimum": 0 },
    "shots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["shot_id", "start", "duration", "camera"],
        "properties": {
          "shot_id": { "type": "string" },
          "start": { "type": "number", "minimum": 0 },
          "duration": { "type": "number", "exclusiveMinimum": 0 },
          "camera": {
            "type": "object",
            "required": ["position", "rotation"],
            "properties": {
              "position": { "$ref": "#/$defs/vector3" },
              "rotation": { "$ref": "#/$defs/vector3" },
              "fov": { "type": "number", "minimum": 1, "maximum": 179 }
            }
          },
          "actor_ids": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    },
    "cues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cue_id", "kind", "start"],
        "properties": {
          "cue_id": { "type": "string" },
          "kind": { "enum": ["dialogue", "subtitle", "voice", "sfx", "music", "vfx", "animation"] },
          "start": { "type": "number", "minimum": 0 },
          "duration": { "type": "number", "minimum": 0 },
          "speaker": { "type": "string" },
          "line_id": { "type": "string" },
          "text": { "type": "string" },
          "asset": { "type": "string" },
          "actor_id": { "type": "string" },
          "payload": { "type": "object" }
        },
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "vector3": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }],
      "minItems": 3,
      "maxItems": 3
    }
  }
}