{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frameforge.dev/schemas/frameforge-project-v2.schema.json",
  "title": "FrameForge V2 Project",
  "description": "Versioned, editable project contract for FrameForge V2.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "project",
    "settings",
    "assets",
    "sequences"
  ],
  "properties": {
    "format": {
      "const": "frameforge-project"
    },
    "schema_version": {
      "const": 2
    },
    "project": {
      "$ref": "#/$defs/projectMetadata"
    },
    "settings": {
      "$ref": "#/$defs/projectSettings"
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "sequences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sequence"
      }
    },
    "creative_brief": {
      "$ref": "#/$defs/creativeBrief"
    },
    "research": {
      "$ref": "#/$defs/researchDossier"
    },
    "extensions": {
      "type": "object",
      "description": "Namespaced extension data for compatible future modules.",
      "additionalProperties": true
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "projectMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 4000
        },
        "author": {
          "type": "string",
          "maxLength": 200
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "projectSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "fps",
        "color_space"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 240
        },
        "color_space": {
          "type": "string",
          "enum": [
            "srgb",
            "display-p3",
            "rec709",
            "rec2020"
          ]
        },
        "pixel_aspect_ratio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1
        },
        "sample_rate": {
          "type": "integer",
          "enum": [
            22050,
            32000,
            44100,
            48000,
            88200,
            96000
          ]
        },
        "audio_channels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "post_processing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "renderer": {
              "type": "string",
              "enum": [
                "auto",
                "webgl",
                "canvas2d"
              ],
              "default": "auto"
            },
            "fallback": {
              "type": "string",
              "enum": [
                "canvas2d"
              ],
              "default": "canvas2d"
            },
            "passes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/postProcessPass"
              }
            }
          }
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "attribution_required"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "approved",
            "restricted",
            "rejected",
            "unknown"
          ]
        },
        "license_name": {
          "type": "string",
          "maxLength": 300
        },
        "license_url": {
          "type": "string",
          "format": "uri"
        },
        "permission_reference": {
          "type": "string",
          "maxLength": 1000
        },
        "attribution_required": {
          "type": "boolean"
        },
        "attribution_text": {
          "type": "string",
          "maxLength": 2000
        },
        "review_basis": {
          "type": "string",
          "minLength": 10,
          "maxLength": 3000
        },
        "reviewed_by": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "restrictions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "approved"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "review_basis",
              "reviewed_by",
              "reviewed_at"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "attribution_required": {
                "const": true
              }
            },
            "required": [
              "attribution_required"
            ]
          },
          "then": {
            "required": [
              "attribution_text"
            ]
          }
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_type"
      ],
      "properties": {
        "source_type": {
          "type": "string",
          "enum": [
            "user_supplied",
            "procedural",
            "public_domain",
            "open_license",
            "permissioned",
            "paid_license",
            "unknown"
          ]
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "source_title": {
          "type": "string",
          "maxLength": 500
        },
        "creator": {
          "type": "string",
          "maxLength": 300
        },
        "provider": {
          "type": "string",
          "maxLength": 200
        },
        "acquired_at": {
          "type": "string",
          "format": "date-time"
        },
        "notes": {
          "type": "string",
          "maxLength": 3000
        }
      }
    },
    "assetMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "sample_rate": {
          "type": "integer",
          "minimum": 1
        },
        "channels": {
          "type": "integer",
          "minimum": 1
        },
        "codec": {
          "type": "string",
          "maxLength": 100
        },
        "mime_type": {
          "type": "string",
          "maxLength": 200
        },
        "alpha_capable": {
          "type": "boolean"
        },
        "decode_status": {
          "type": "string",
          "maxLength": 100
        },
        "external_dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "dependency_warning": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "uri",
        "media_type",
        "provenance",
        "rights"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "media_type": {
          "type": "string",
          "enum": [
            "image",
            "video",
            "audio",
            "graphic",
            "model3d",
            "font",
            "other"
          ]
        },
        "label": {
          "type": "string",
          "maxLength": 300
        },
        "metadata": {
          "$ref": "#/$defs/assetMetadata"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "rights": {
          "$ref": "#/$defs/rights"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "uniqueItems": true
        }
      }
    },
    "vector2": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "position": {
          "$ref": "#/$defs/vector2"
        },
        "scale": {
          "$ref": "#/$defs/vector2"
        },
        "rotation_degrees": {
          "type": "number"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "anchor": {
          "$ref": "#/$defs/vector2"
        },
        "crop": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "width",
            "height"
          ],
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            }
          }
        },
        "fit": {
          "type": "string",
          "enum": [
            "contain",
            "cover",
            "stretch"
          ],
          "default": "contain"
        }
      }
    },
    "keyframe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "property",
        "frame",
        "value"
      ],
      "properties": {
        "property": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "frame": {
          "type": "integer",
          "minimum": 0
        },
        "interpolation": {
          "type": "string",
          "enum": [
            "step",
            "linear",
            "ease_in",
            "ease_out",
            "ease_in_out",
            "bezier"
          ],
          "default": "linear"
        },
        "value": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "maxItems": 16
            },
            {
              "type": "object"
            }
          ]
        },
        "bezier": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "minItems": 4,
          "maxItems": 4
        }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "parameters": {
          "type": "object",
          "additionalProperties": true
        },
        "start_frame": {
          "type": "integer",
          "minimum": 0
        },
        "duration_frames": {
          "type": "integer",
          "minimum": 1
        },
        "keyframes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/keyframe"
          }
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "duration_frames"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "crossfade",
            "fade",
            "wipe",
            "zoom",
            "whip_pan",
            "radial",
            "hypnosis_wheel",
            "swirl_warp",
            "glitch",
            "custom"
          ]
        },
        "duration_frames": {
          "type": "integer",
          "minimum": 1
        },
        "direction": {
          "type": "string",
          "enum": [
            "in",
            "out",
            "left",
            "right",
            "up",
            "down",
            "clockwise",
            "counterclockwise"
          ]
        },
        "parameters": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "intensity": {
              "type": "number",
              "minimum": 0,
              "maximum": 2,
              "default": 1
            },
            "segments": {
              "type": "integer",
              "minimum": 3,
              "maximum": 64,
              "default": 12
            }
          }
        }
      }
    },
    "clip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "start_frame",
        "duration_frames",
        "enabled"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "type": "string",
          "enum": [
            "asset",
            "generated",
            "sequence",
            "effect"
          ]
        },
        "asset_id": {
          "$ref": "#/$defs/id"
        },
        "sequence_id": {
          "$ref": "#/$defs/id"
        },
        "effect_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "generator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "parameters": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "start_frame": {
          "type": "integer",
          "minimum": 0
        },
        "duration_frames": {
          "type": "integer",
          "minimum": 1
        },
        "source_in_frame": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "playback_rate": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1
        },
        "enabled": {
          "type": "boolean"
        },
        "transform": {
          "$ref": "#/$defs/transform"
        },
        "keyframes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/keyframe"
          }
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effect"
          }
        },
        "transition_in": {
          "$ref": "#/$defs/transition"
        },
        "transition_out": {
          "$ref": "#/$defs/transition"
        },
        "evidence_claim_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "notes": {
          "type": "string",
          "maxLength": 3000
        },
        "parent_clip_id": {
          "$ref": "#/$defs/id"
        },
        "blend_mode": {
          "type": "string",
          "enum": [
            "normal",
            "multiply",
            "screen",
            "overlay",
            "darken",
            "lighten",
            "color-dodge",
            "color-burn",
            "hard-light",
            "soft-light",
            "difference",
            "exclusion",
            "hue",
            "saturation",
            "color",
            "luminosity",
            "lighter",
            "destination-over"
          ],
          "default": "normal"
        },
        "mask": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "shape",
                "alpha",
                "luma"
              ]
            },
            "shape": {
              "type": "string",
              "enum": [
                "rect",
                "ellipse"
              ]
            },
            "feather": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "default": 0
            },
            "invert": {
              "type": "boolean",
              "default": false
            },
            "bounds": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "x",
                "y",
                "width",
                "height"
              ],
              "properties": {
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "y": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "width": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                },
                "height": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                }
              }
            },
            "asset_id": {
              "$ref": "#/$defs/id"
            },
            "channel": {
              "type": "string",
              "enum": [
                "alpha",
                "luma"
              ]
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "asset"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "asset_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "generated"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "generator"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "sequence"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "sequence_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "effect"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "effect_id"
            ]
          }
        }
      ]
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "type",
        "order",
        "enabled",
        "muted",
        "clips"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "type": {
          "type": "string",
          "enum": [
            "video",
            "image",
            "graphic",
            "title",
            "scene3d",
            "audio",
            "music",
            "sfx",
            "voiceover",
            "effect",
            "adjustment"
          ]
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "enabled": {
          "type": "boolean"
        },
        "muted": {
          "type": "boolean"
        },
        "locked": {
          "type": "boolean",
          "default": false
        },
        "clips": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/clip"
          }
        }
      }
    },
    "sequence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "width",
        "height",
        "fps",
        "duration_frames",
        "tracks"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 240
        },
        "duration_frames": {
          "type": "integer",
          "minimum": 1
        },
        "tracks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/track"
          }
        }
      }
    },
    "creativeBrief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topic",
        "niche",
        "platform"
      ],
      "properties": {
        "topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "niche": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "audience": {
          "type": "string",
          "maxLength": 1000
        },
        "platform": {
          "type": "string",
          "enum": [
            "youtube_longform",
            "youtube_shorts",
            "other"
          ]
        },
        "target_duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "tone": {
          "type": "string",
          "maxLength": 300
        },
        "visual_direction": {
          "type": "string",
          "maxLength": 3000
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    },
    "researchSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "url",
        "retrieved_at"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "title": {
          "type": "string",
          "maxLength": 500
        },
        "publisher": {
          "type": "string",
          "maxLength": 200
        },
        "published_at": {
          "type": "string",
          "format": "date-time"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "notes": {
          "type": "string",
          "maxLength": 3000
        }
      }
    },
    "researchClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "verification_status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "source_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "confidence": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "unassessed"
          ]
        },
        "verification_status": {
          "type": "string",
          "enum": [
            "unverified",
            "verified",
            "disputed",
            "opinion",
            "illustrative"
          ]
        }
      }
    },
    "researchDossier": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/researchSource"
          }
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/researchClaim"
          }
        },
        "visual_style_observations": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "researched_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "postProcessPass": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "enabled",
        "parameters"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "type": "string",
          "enum": [
            "brightness-contrast",
            "saturation",
            "vignette",
            "blur",
            "glow",
            "light-rays",
            "depth-of-field",
            "chromatic-aberration",
            "glitch",
            "ripple",
            "shake",
            "motion-blur",
            "custom"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": true
        },
        "keyframes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/keyframe"
          }
        }
      }
    }
  }
}
